APP_ENV=development
APP_NAME=KnowBridge
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=replace-with-a-unique-32-character-minimum-local-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

POSTGRES_DB=knowbridge
POSTGRES_USER=knowbridge
POSTGRES_PASSWORD=change-me-for-local-demo
DATABASE_URL=postgresql+psycopg://knowbridge:change-me-for-local-demo@postgres:5432/knowbridge

QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434
# Demo model; pull it into the local Ollama volume before running the seeder.
OLLAMA_MODEL=llama3.2:3b
# Local model files are mounted into the backend container at /models.
EMBEDDING_MODEL=/models/all-MiniLM-L6-v2
DOCUMENT_STORAGE_PATH=/data/documents
